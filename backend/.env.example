# Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tavily API Configuration (for web question paper search / ground truth)
TAVILY_API_KEY=

# Security / Admin Token (optional: if set, protects library paper management & upload)
ADMIN_TOKEN=

# Database Configuration
DATABASE_URL=sqlite:///./vtu_planner.db

# App Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
